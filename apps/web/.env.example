# Vercel AI Gateway
AI_GATEWAY_API_KEY=

# Local PostgreSQL via kind cluster
DATABASE_URL=postgresql://lattik:lattik-local@localhost:5432/lattik_studio

# Must be https://lattik-studio.dev for local dev (portless --tld dev)
AUTH_URL=https://lattik-studio.dev

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — only needed in production. In development, sign in with
# admin/admin credentials instead (no Google setup required).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Iceberg REST catalog (local dev)
ICEBERG_REST_URL=http://localhost:8181

# Gitea (local dev)
GITEA_URL=http://localhost:3300
# Run `pnpm gitea:start` to launch Gitea, then `pnpm gitea:init-logs` and copy
# the value from the `GITEA_TOKEN=...` line printed by the gitea-init job.
GITEA_TOKEN=
GITEA_ORG=lattik
GITEA_REPO=pipelines
# Generate with: openssl rand -hex 32
GITEA_WEBHOOK_SECRET=

# Shared secret for the Lattik Table commit API. Spark batch drivers and the
# backfill driver authenticate with this via `Authorization: Bearer ...`.
# Must match the LATTIK_API_TOKEN key in the `lattik-api-credentials` secret
# in the `workloads` namespace (k8s/spark-rbac.yaml).
# Generate with: openssl rand -hex 32
LATTIK_API_TOKEN=

# Secret for protected cron endpoints. The /api/scheduler/tick route is
# invoked by Vercel Cron every minute with `Authorization: Bearer $CRON_SECRET`.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Batch scheduler (DAGs synced from lattik-pipelines).
# ---------------------------------------------------------------------------

# Read/write token for Vercel Blob — bundle.js + manifest.json + per-DAG YAMLs
# live here. Auto-provisioned by the Vercel Blob Marketplace integration.
BLOB_READ_WRITE_TOKEN=

# Bearer token for /api/dags/sync. The lattik-pipelines GitHub Action sends
# `Authorization: Bearer $LATTIK_DAGS_SYNC_TOKEN` to register new DAGs.
# Generate with: openssl rand -hex 32
LATTIK_DAGS_SYNC_TOKEN=

# Master HMAC key for sandbox → app completion callbacks. The launch step
# HKDF-derives a per-attempt signing key from this and ships only the derived
# key into the sandbox; the master never leaves the controller process.
# Generate with: openssl rand -hex 32
LATTIK_SANDBOX_HMAC_KEY=

# Public origin of this deployment (e.g. https://lattik-studio.vercel.app).
# Used by launchTaskSandbox to compose the sandbox callback URL. Must be set
# in production — the sandbox cannot reach http://localhost:3000 from a
# Vercel Sandbox host.
NEXT_PUBLIC_BASE_URL=
